[Unit]
Description=liftlab sub-stream relay (7 cabins -> VM, HLS copy) — the Pi's only job
After=network-online.target
Wants=network-online.target
# No liftlab-watch dependency: the watch is retired (its deliverable is banked at 2.81s close,
# n=1053) and door cycles now come from the GPU engine on the same feed. The Pi is a dumb streamer.
# Start-rate limiter DISABLED (these keys live in [Unit], not [Service], on systemd >= 229 — in
# [Service] they are silently ignored, which would leave the limiter armed). A crash loop is noisy
# and visible; a Pi that quietly gave up streaming is silent, and silence is what has cost us data.
StartLimitIntervalSec=0

[Service]
Type=simple
User=askjitk
# creds injected by systemd (root reads this file, passes to the askjitk process)
EnvironmentFile=/etc/liftlab-agent.env
Environment=RELAY_CSV=/home/askjitk/liftlab-watch/relay_soak.csv
Environment=RELAY_INTERVAL=30
# Stall detection. A stream whose newest segment on the VM is older than RELAY_SEG_STALL_S is dead
# regardless of what its process status or bitrate says; two strikes at INTERVAL=30 restarts it
# ~60-90s in. RELAY_LOOP_STALL_S guards the SUPERVISOR itself — a dumb streamer still needs dumb
# babysitting, so the loop has to prove it is turning.
Environment=RELAY_SEG_STALL_S=60
Environment=RELAY_LOOP_STALL_S=120
Environment=RELAY_CALL_TIMEOUT=10
ExecStart=/bin/bash /home/askjitk/liftlab-b3/pi-agent/relay_soak.sh
# ALWAYS restart. There is no longer any exit this service can make that should leave it dead: the
# door guard's deliberate exit-0 (which cost 22h + 25min of pipeline data) is gone, so every exit is
# now a fault. (Rate limiter is disabled in [Unit] above.)
Restart=always
RestartSec=15
# never let the relay drag the box down
Nice=5
CPUWeight=50

[Install]
WantedBy=multi-user.target
