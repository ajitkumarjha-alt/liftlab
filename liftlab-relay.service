[Unit]
Description=liftlab overnight sub-stream relay soak (7 cabins -> VM, HLS copy)
After=network-online.target liftlab-watch.service
Wants=network-online.target
# The door watch is sacred; relay is expendable. If the watch is down, still allow relay,
# but the relay self-kills on door_fps sag (see relay_soak.sh DOOR GUARD).

[Service]
Type=simple
User=askjitk
# creds injected by systemd (root reads this file, passes to the askjitk process) — same as
# liftlab-watch, so no root-only-file read problem inside the script.
EnvironmentFile=/etc/liftlab-agent.env
Environment=RELAY_CSV=/home/askjitk/liftlab-watch/relay_soak.csv
Environment=RELAY_INTERVAL=30
# DOOR GUARD. NO RELAY_DOOR_FLOOR here on purpose: setting it pins an absolute floor and overrides
# the measured-baseline logic, which is what tripped the relay at 9.35/9.44 — inside normal jitter of
# the ~9.4 baseline. The floor is now derived per-start as baseline*(1-margin), never below the 6.0
# quality alarm, from a baseline measured BEFORE any ffmpeg is spawned.
Environment=RELAY_DOOR_MARGIN=0.15
Environment=RELAY_DOOR_ABS_FLOOR=6.0
Environment=RELAY_DOOR_LOW_S=60
Environment=RELAY_DOOR_GRACE_S=120
Environment=RELAY_DOOR_COOLDOWN_S=600
Environment=RELAY_DOOR_TRIPS_MAX=3
# Stall detection (the 22h-outage fix). A stream whose newest segment on the VM is older than
# RELAY_SEG_STALL_S is dead regardless of what its process status or bitrate says; two strikes at
# INTERVAL=30 restarts it ~60-90s in. RELAY_LOOP_STALL_S guards the SUPERVISOR itself — it froze
# for 22h while systemd reported active, so the loop now has to prove it is turning.
Environment=RELAY_SEG_STALL_S=60
Environment=RELAY_LOOP_STALL_S=120
Environment=RELAY_CALL_TIMEOUT=10
ExecStart=/bin/bash /home/askjitk/liftlab-b3/pi-agent/relay_soak.sh
# on-failure only: a DOOR GUARD trip exits 0 (stay stopped, don't fight the watch); a crash
# exits non-zero and restarts. Internal per-stream restarts handle wifi/NVR dropouts.
Restart=on-failure
RestartSec=15
# never let the relay drag the box down
Nice=5
CPUWeight=50

[Install]
WantedBy=multi-user.target
